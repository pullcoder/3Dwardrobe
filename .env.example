# 선택 사항: 루트 .env로 복사. 기본 로컬 실행에는 만들지 않아도 됩니다.
APP_ENV=development
# JSON 배열. 로컬 미리보기 API가 허용할 프론트 주소.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
# 기본 로컬 SQLite. PostgreSQL 실행 시 postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/stylefit
DATABASE_URL=sqlite:///storage/stylefit.db
MAX_REQUEST_BYTES=85000000
# 관리자 신고 검토 API 전용. 실제 값은 무작위 비밀값으로 설정하고 공개/프론트에 전달하지 않습니다.
ADMIN_REVIEW_KEY=
# Docker 개발 DB를 켤 때 설정. Redis는 아직 사용하지 않습니다.
POSTGRES_PASSWORD=
# Vite 변수는 frontend/.env.example을 참고하세요. 비밀값을 VITE_ 변수로 넣지 마세요.
# E2E 전용 Python 실행 경로 재정의 (비어 있으면 backend/.venv 사용)
STYLEFIT_TEST_PYTHON=
