# ============================================================
# CLOSET-VERSE 환경변수 예시
# 이 파일을 복사해 .env 를 만들고 값을 채우세요.  (cp .env.example .env)
# .env 는 절대 커밋하지 마세요. 실제 키는 팀 비공개 채널로만 공유합니다.
# .env 는 저장소 루트에 하나만 둡니다. backend(설정 코드)와 frontend(vite envDir)가 루트 .env를 읽도록 설정합니다.
# ============================================================

# ----- 공통 -----
APP_ENV=development            # development | staging | production

# ----- Backend (FastAPI) -----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=                    # 임의의 긴 문자열 (예: python -c "import secrets;print(secrets.token_hex(32))")
JWT_EXPIRE_MINUTES=1440

# ----- Database (PostgreSQL) -----
POSTGRES_USER=closetverse
POSTGRES_PASSWORD=
POSTGRES_DB=closetverse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://closetverse:<password>@localhost:5432/closetverse

# ----- Redis / Celery (비동기 AI 추론) -----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ----- 파일 저장소 -----
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_DIR=./storage       # backend 폴더에서 실행 → backend/storage/
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ----- 개인정보 -----
DELETE_ORIGINAL_BODY_PHOTO=true   # 체형 분석 후 원본 사진 삭제 (기본값 true 유지)

# ----- AI 모델 -----
SEGMENTATION_MODEL=rmbg           # rmbg | sam
BODY_MESH_MODEL=makehuman        # M+6 3D 인체 메시. SMPL은 유료 라이선스 계약 전까지 사용 금지
BODY_MESH_DIR=./models/weights/body_mesh
VLM_PROVIDER=                     # 예: openai | anthropic | local
VLM_MODEL=
VLM_API_KEY=
OCR_PROVIDER=                     # 예: paddleocr | easyocr | clova
OCR_API_KEY=

# ----- 추천 -----
MATCH_SCORE_THRESHOLD=70         # 0~100, 이 점수 이상이면 "어울림"

# ----- 제휴몰 공식 API (M+6) -----
PARTNER_API_BASE_URL=
PARTNER_API_KEY=

# ----- Frontend (Vite: VITE_ 로 시작해야 브라우저에서 읽힘. 비밀값 넣지 말 것) -----
VITE_API_BASE_URL=http://localhost:8000/api/v1
