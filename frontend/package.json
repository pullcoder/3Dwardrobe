{
  "name": "stylefit-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:vision": "node scripts/prepare-vision.mjs",
    "prepare:test-photo": "node scripts/prepare-test-photo.mjs",
    "predev": "npm run prepare:vision",
    "prebuild": "npm run prepare:vision",
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write src",
    "prepare:test-garments": "node scripts/prepare-test-garments.mjs",
    "pretest:e2e": "npm run prepare:test-garments",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
